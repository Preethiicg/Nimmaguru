<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <EditText android:id="@+id/etName" android:hint="Name" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etSkills" android:hint="Skills (comma separated)" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etAvailability" android:hint="Available time slots" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etLocation" android:hint="Village/Area" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/etBio" android:hint="Bio" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnSaveProfile" android:text="Save Profile" android:textSize="20sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
